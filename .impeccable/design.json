  "narrative": {
    "northStar": "The Field Logbook",
    "overview": "A working logbook carried into the field, not a dashboard on a wall. The user opens it on a phone between other things: it has to say at once what is moving, what is stuck and what is ready, and it has to take a new entry with one thumb. Every visual decision answers two questions: can this be read in a glance, and can it be hit with a thumb? Style loses when it competes with either.",
    "keyCharacteristics": [
      "Monochrome bb chrome; colour is spent only on state (status, blocking, priority, type).",
      "Status carried by glyph shape first, colour second.",
      "Thumb-sized rows and controls (44px) on touch; tighter only for fine pointers.",
      "Metadata never below 12px.",
      "Flat surfaces; tonal layers instead of shadows."
    ],
    "rules": [
      {
        "name": "The State-Only Colour Rule",
        "body": "Hue appears only where it encodes issue state, priority or type. Chrome, borders, buttons and section headings stay neutral.",
        "section": "colors"
      },
      {
        "name": "The Shape-First Rule",
        "body": "Every status reads without colour: ring = open, half fill = in progress, slash = blocked, dashed ring = deferred, filled check = closed. Colour only reinforces.",
        "section": "colors"
      },
      {
        "name": "The 12px Floor Rule",
        "body": "No text below 12px. bb's text-2xs (10px) is not used for anything the user must read.",
        "section": "typography"
      },
      {
        "name": "The Tabular Numbers Rule",
        "body": "Counts, progress, priorities and dates use tabular-nums.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "Surfaces are flat at rest; a shadow is allowed only on something floating over content (picker, popover).",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use bb theme variables and Tailwind tokens (`text-foreground`, `bg-surface-recessed`, `var(--timeline-accent)`). Never use literal colours or Tailwind palette classes.",
      "Do give every touch target at least 44 by 44px on coarse pointers.",
      "Do keep text at 12px or larger, and use 16px in inputs on touch.",
      "Do pair every status colour with its glyph shape.",
      "Do follow issue-tracker conventions (title first, property chips, sub-issues, blocked-by) before inventing a pattern.",
      "Do show `bd`'s own error text inline and keep the user's draft intact."
    ],
    "donts": [
      "Don't add colour to chrome, headings, or buttons. Colour encodes state only.",
      "Don't use `text-2xs` (10px) for readable content.",
      "Don't reveal actions only on hover. Touch has no hover. The incumbent copy-ID button does this, and it should be made always visible or moved into a menu.",
      "Don't put a form or detail in a modal. They take over the panel, with a back control.",
      "Don't use cards, nested boxes, side-stripe accents, or decorative shadows."
    ]
  }
}
